# Hello MCP Server Configuration

# Required: Your Keycard STS issuer URL (Retrieve from Zone Settings)
KEYCARD_STS_ISSUER_URL=https://your-zone-id.keycard.cloud

# Optional: Server configuration  
PORT=8888
HOST=localhost

# Optional: Observability settings
OTEL_SERVICE_NAME=hello-mcp-server
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=development
ENABLE_OTEL=true

# Logging Configuration
LOG_LEVEL=INFO

# OpenTelemetry Endpoints (optional - only needed for production)
# Comment out for development to use clean console logging instead
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces